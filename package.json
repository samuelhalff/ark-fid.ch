{
  "name": "ark-fid.ch",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=20 <21" },
  "scripts": {
    "dev": "next dev -p 5000",
    "predev": "node scripts/lint-translations.js || true",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "analyze:open": "ANALYZE=true BROWSER=true next build",
    "start": "PORT=${PORT:-5000} node .next/standalone/server.js",
    "lint": "next lint",
    "css:build": "tailwindcss -i ./app/globals.css -o ./public/assets/css/non-critical.css --config tailwind.config.ts --minify",
    "css:watch": "tailwindcss -i ./app/globals.css -o ./public/assets/css/non-critical.css --config tailwind.config.ts --watch",
    "css:report": "node scripts/report-unused-css.js",
    "optimize:images": "node scripts/optimize-images.js",
    "compress:images": "node scripts/compress-images.js --dir public/assets --threshold 100 --quality 82",
    "images:hero-blur": "node scripts/generate-hero-blur-data.js",
    "images:prepare": "npm run optimize:images && npm run images:hero-blur",
    "lint:hero-blur": "node scripts/check-hero-blur.js",
    "assets:pdfs": "node scripts/download-missing-pdfs.js --locale fr",
    "assets:pdfs:dry": "node scripts/download-missing-pdfs.js --locale fr --dry-run",
    "assets:audit": "node scripts/audit-image-usage.js > image-usage.csv",
    "assets:cleanup": "node scripts/cleanup-unused-originals.js",
    "assets:lint": "node scripts/check-assets.js",
    "links:list": "node scripts/check-links.js",
    "links:check": "NEXT_BASE_URL=http://localhost:5000 node scripts/check-links.js --http",
    "ping:sitemaps": "node scripts/ping-sitemaps.js",
    "ressources:sync": "node scripts/sync-ressources.js --apply",
    "ressources:check": "node scripts/sync-ressources.js --check",
    "ai:ressources:dry": "node scripts/ai-ressources-update.js --dry-run",
    "ai:ressources:apply": "node scripts/ai-ressources-update.js --apply",
    "articles:translate:dry": "node scripts/translate-articles.js --dry-run",
    "articles:translate": "node scripts/translate-articles.js --apply",
    "lint:translations": "node scripts/lint-translations.js",
    "lint:articles": "node scripts/lint-articles-parity.js",
    "lint:metadata": "node scripts/lint-metadata.js",
    "lint:ressources:schema": "node scripts/lint-ressources-schema.js",
    "lint:translations:missing": "node scripts/check-missing-translation-keys.js",
    "lint:legal": "node scripts/lint-legal.js",
    "lint:capitalization": "node scripts/lint-capitalization.js",
    "lint:capitalization:fix": "node scripts/lint-capitalization.js --fix"
  },
  "dependencies": {
    "@azure/ai-projects": "^1.0.0-beta.2",
    "@azure/identity": "^4.4.1",
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@vercel/analytics": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.1.7",
    "i18next": "^25.4.1",
    "lucide-react": "^0.417.0",
    "next": "14.2.10",
    "next-themes": "^0.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.52.1",
    "react-i18next": "15.7.3",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.6.0",
    "vaul": "^0.9.1",
    "ws": "^8.18.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "14.2.10",
    "@types/node": "^20.14.12",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.10",
    "postcss": "^8.5.6",
    "purgecss": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^7.18.0"
  }
}
