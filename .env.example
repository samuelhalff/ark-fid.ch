# Public site URL used in metadata and IndexNow host/keyLocation
NEXT_PUBLIC_SITE_URL=https://ark-fid.ch

# Desktop/default tracking ID
# Google Analytics 4 Measurement ID (public)
NEXT_PUBLIC_GA_ID=G-BXZ54E31FL

# IndexNow key (also served at https://ark-fid.ch/<INDEXNOW_KEY>.txt)
INDEXNOW_KEY=your-key-here

# Secret header to protect the reindex endpoint (/api/indexnow/reindex)
# Set this in your hosting env and in GitHub Actions secrets as INDEXNOW_SECRET
INDEXNOW_SECRET=your-secret-here

# Restart endpoint secret token
# Used by /api/restart to securely trigger application restart via process.exit(0)
# Infomaniak's orchestrator will automatically restart the app when it exits
# Set this in your hosting env and in GitHub Actions secrets as RESTART_SECRET_TOKEN
RESTART_SECRET_TOKEN=

# Azure OpenAI (chat completions) for translations
# Endpoint should be the full chat completions URL without query params, or base + deployments path.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Azure AI Foundry Agent for AI ressources update
# AZURE_AGENT_ENDPOINT: The Foundry project endpoint (https://<resource>.services.ai.azure.com/api/projects/<project>)
# AZURE_AGENT_NAME: Agent name or asst_ ID (if you still have one)
# Uses Entra ID authentication via AZURE_CREDENTIALS (tenantId, clientId, clientSecret)
AZURE_AGENT_ENDPOINT=
AZURE_AGENT_NAME=
# For new Foundry agents (OpenAI Responses API)
AZURE_AGENT_RESPONSES_API_VERSION=2025-11-15-preview
# Optional: allow fallback to classic thread/run if Responses API fails
AZURE_AGENT_ALLOW_CLASSIC_FALLBACK=0
# Optional: force OpenAI Responses API even if a classic agent exists
AZURE_AGENT_FORCE_RESPONSES=0
# Optional: retry count for Responses API 429/503
AZURE_AGENT_RESPONSES_RETRIES=4
# Optional: base backoff (ms) for Responses API retries
AZURE_AGENT_RESPONSES_BACKOFF_MS=15000
# Optional: max backoff (ms) for Responses API retries
AZURE_AGENT_RESPONSES_BACKOFF_MAX_MS=120000
# Optional: backoff jitter (ms) for Responses API retries
AZURE_AGENT_RESPONSES_BACKOFF_JITTER_MS=2000
# Optional: timeout (ms) per Responses API call
AZURE_AGENT_RESPONSES_TIMEOUT_MS=180000
# Optional: cooldown (ms) after each Responses API call
AZURE_AGENT_RESPONSES_COOLDOWN_MS=8000
# Optional: limit output tokens for Responses API (0 = default)
AZURE_AGENT_RESPONSES_MAX_OUTPUT_TOKENS=0

# Word count guidance/enforcement for the generated FR article
# When SEO_MIN_WORDS is set (>0), the prompt is updated accordingly and generation retries if the draft is too short.
SEO_MIN_WORDS=0
# Optional max guidance (not enforced by code)
SEO_MAX_WORDS=3000

# Reference quality guardrails
# If 1, only allow domains from scripts/lib/referenceValidator.js TRUSTED_DOMAINS
REFERENCE_REQUIRE_TRUSTED_DOMAINS=0
# Minimum number of references to keep after validation/deduplication
REFERENCE_MIN_COUNT=3
# Maximum number of references to keep
REFERENCE_MAX_COUNT=6
# Require at least N references from TRUSTED_DOMAINS (e.g., official domains)
REFERENCE_MIN_TRUSTED_DOMAINS=1
# Optional CSV allowlist (e.g. admin.ch,bsv.admin.ch,estv.admin.ch,fedlex.admin.ch,ge.ch,vd.ch,finma.ch,seco.admin.ch,swissdec.ch,odoo.com)
REFERENCE_ALLOWED_DOMAINS=
# Legacy support (deprecated, use AZURE_AGENT_NAME instead)
# AZURE_AGENT_ID=

# Trend provider configuration for SEO-driven topic selection
# Set these in GitHub repository variables (vars.*) for the workflow
# TRENDS_PROVIDER: Provider for trend data (default: google_trends)
TRENDS_PROVIDER=google_trends
# TRENDS_GEO: Geographic region for trends (default: CH for Switzerland)
TRENDS_GEO=CH
# TRENDS_LANGUAGE: Language for trend results (default: fr for French)
TRENDS_LANGUAGE=fr
# TRENDS_MAX_TOPICS: Maximum number of topics to fetch (default: 10)
TRENDS_MAX_TOPICS=10
